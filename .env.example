# --- Lemon Squeezy (payments + license keys). All values are PUBLIC identifiers, not secrets. ---
# Store ID: Lemon Squeezy dashboard → Settings → Stores (numeric ID)
VITE_LS_STORE_ID=
# Comma-separated product IDs whose license keys unlock Pro
VITE_LS_PRODUCT_IDS=
# Checkout links: Products → (product) → Share → copy the checkout URL for each variant
VITE_LS_CHECKOUT_MONTHLY=
VITE_LS_CHECKOUT_YEARLY=
# Optional: customer portal URL
VITE_LS_PORTAL_URL=

# --- Optional cookie-less analytics: your GoatCounter code (the "xyz" in xyz.goatcounter.com) ---
VITE_GOATCOUNTER_CODE=

# --- Site location (set by CI for GitHub Pages) ---
SITE_URL=http://localhost:5199/
SITE_BASE=/
